### Walk through the API from IntelliJ: run the requests top to bottom (▶ in the gutter).
### Needs `docker compose up -d` and the app running. Tokens are passed along automatically.

### Register (change the email to sign up again)
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{"email": "me@example.com", "password": "12345678"}

> {%
    client.global.set("access", response.body.accessToken);
    client.global.set("refresh", response.body.refreshToken);
%}

### Log in (if already registered)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{"email": "me@example.com", "password": "12345678"}

> {%
    client.global.set("access", response.body.accessToken);
    client.global.set("refresh", response.body.refreshToken);
%}

### Who am I
GET http://localhost:8080/api/me
Authorization: Bearer {{access}}

### Sync: push one room and one session from "the phone"
POST http://localhost:8080/api/sync
Authorization: Bearer {{access}}
Content-Type: application/json

{
  "cursor": 0,
  "rooms": [{
    "id": "11111111-1111-1111-1111-111111111111",
    "name": "Magnetic", "artist": "ILLIT", "genre": "kpop", "note": null,
    "videoFileName": "magnetic.mov",
    "createdAt": "2026-10-28T10:00:00Z", "lastOpenedAt": null,
    "updatedAt": "2026-10-28T10:00:00Z", "deletedAt": null
  }],
  "sessions": [{
    "id": "22222222-2222-2222-2222-222222222222",
    "roomId": "11111111-1111-1111-1111-111111111111",
    "roomName": "Magnetic", "genre": "kpop",
    "startedAt": "2026-10-28T10:05:00Z", "durationSeconds": 600
  }]
}

> {% client.global.set("cursor", response.body.cursor); %}

### Sync from "another device" (cursor 0 pulls everything)
POST http://localhost:8080/api/sync
Authorization: Bearer {{access}}
Content-Type: application/json

{"cursor": 0}

### Sync again with the saved cursor: nothing new
POST http://localhost:8080/api/sync
Authorization: Bearer {{access}}
Content-Type: application/json

{"cursor": {{cursor}}}

### Rooms
GET http://localhost:8080/api/rooms
Authorization: Bearer {{access}}

### Stats
GET http://localhost:8080/api/stats/summary?zone=Europe/London
Authorization: Bearer {{access}}

### Refresh (run twice with the old token to see reuse detection)
POST http://localhost:8080/api/auth/refresh
Content-Type: application/json

{"refreshToken": "{{refresh}}"}

> {%
    client.global.set("access", response.body.accessToken);
    client.global.set("refresh", response.body.refreshToken);
%}

### Log out
POST http://localhost:8080/api/auth/logout
Content-Type: application/json

{"refreshToken": "{{refresh}}"}

### Delete the account and all its data
DELETE http://localhost:8080/api/me
Authorization: Bearer {{access}}
