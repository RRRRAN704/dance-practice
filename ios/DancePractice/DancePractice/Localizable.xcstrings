    "This device has %lld guest rooms and %lld practice sessions. Import them into this account to sync them to the cloud. Guest data is kept, and importing again only updates — it never duplicates." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has %#@rooms@ and %#@sessions@. Import them into this account to sync them to the cloud. Guest data is kept, and importing again only updates — it never duplicates."
          },
          "substitutions" : {
            "rooms" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg guest room"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg guest rooms"
                    }
                  }
                }
              }
            },
            "sessions" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg practice session"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg practice sessions"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机有 %1$lld 个游客练习室、%2$lld 条练习记录，可以导入当前账号并同步到云端。游客数据会保留；以后再导入只会更新，不会重复。"
          }
        }
      }
    },
